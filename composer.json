{
  "name": "davidhirtz/yii2-tenant",
  "description": "Multi-tenant support for Yii 2 framework",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-vite",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "davidhirtz/yii2-skeleton": "^2.5"
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.0",
    "codeception/module-filesystem": "^3.0",
    "codeception/module-phpbrowser": "^3.0",
    "codeception/module-yii2": "^1.1",
    "codeception/specify": "^2.0",
    "codeception/verify": "^3.0",
    "phpro/grumphp-shim": "^2.4",
    "phpunit/phpunit": "^9",
    "rector/rector": "^2.0",
    "symplify/easy-coding-standard": "^12.5",
    "yiisoft/yii2-debug": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "davidhirtz\\yii2\\tenant\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "davidhirtz\\yii2\\tenant\\tests\\": "tests"
    }
  },
  "extra": {
    "bootstrap": "davidhirtz\\yii2\\tenant\\Bootstrap"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "phpro/grumphp-shim": true
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "rector": "rector",
    "test": "codecept run"
  }
}
