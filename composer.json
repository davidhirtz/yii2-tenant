{
  "name": "davidhirtz/yii2-tenant",
  "description": "Multi-tenant support for Yii 2 framework",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-vite",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-skeleton": "v3.x-dev"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "davidhirtz\\yii2\\tenant\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "davidhirtz\\yii2\\tenant\\tests\\": "tests"
    }
  },
  "extra": {
    "bootstrap": "davidhirtz\\yii2\\tenant\\Bootstrap"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit"
  }
}
