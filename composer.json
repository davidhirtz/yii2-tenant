{
  "name": "davidhirtz/yii2-tenant",
  "description": "Multi-tenant support for Yii 2 framework",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-tenant",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-skeleton": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Hirtz\\Tenant\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hirtz\\Tenant\\Tests\\": "tests"
    }
  },
  "extra": {
    "bootstrap": "Hirtz\\Tenant\\Bootstrap",
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=2G",
    "test": "phpunit"
  }
}
